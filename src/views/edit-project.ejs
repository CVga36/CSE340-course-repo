<%- include('partials/header') %>

<main class="container">

    <h1><%= title %></h1>

    <!-- Validation errors -->
    <% if (errors.length > 0) { %>
        <div class="error-message" role="alert">
            <% errors.forEach(error => { %>
                <p><%= error.msg %></p>
            <% }); %>
        </div>
    <% } %>

    <form action="/edit-project/<%= projectDetails.project_id %>" method="POST">

        <div class="form-group">
            <label for="title">Project Title</label>
            <input
                type="text"
                id="title"
                name="title"
                value="<%= projectDetails.title %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required
            ><%= projectDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="location">Location</label>
            <input
                type="text"
                id="location"
                name="location"
                value="<%= projectDetails.location %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="projectDate">Project Date</label>
            <input
                type="date"
                id="projectDate"
                name="projectDate"
                value="<%= projectDetails.project_date %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="organizationId">Organization</label>

            <select id="organizationId" name="organizationId" required>

                <% organizations.forEach(organization => { %>

                    <option
                        value="<%= organization.organization_id %>"
                        <%= String(projectDetails.organization_id) === String(organization.organization_id) ? 'selected' : '' %>
                    >
                        <%= organization.name %>
                    </option>

                <% }); %>

            </select>
        </div>

        <button type="submit">Update Project</button>

    </form>

    <p>
        <a href="/project/<%= projectDetails.project_id %>">
            Back to Project
        </a>
    </p>

</main>

<%- include('partials/footer') %>