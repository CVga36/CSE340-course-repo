<%- include('partials/header') %>

<main class="container">

    <section class="page-header">
        <h1><%= title %></h1>

        <p>
            Meet our partner organizations that are
            making a positive difference in communities.
        </p>
    </section>

    <section class="organizations">

        <h2>Our Partner Organizations</h2>

        <div class="organization-grid">

            <article class="organization-card">
                <img
                    src="/images/brightfuture-logo.png"
                    alt="BrightFuture Builders logo"
                >

                <h3>BrightFuture Builders</h3>

                <p>
                    Supporting communities through
                    construction and development projects.
                </p>

                <a href="mailto:info@brightfuture.org">
                    Contact Organization
                </a>
            </article>

            <article class="organization-card">
                <img
                    src="/images/greenharvest-logo.png"
                    alt="GreenHarvest Growers logo"
                >

                <h3>GreenHarvest Growers</h3>

                <p>
                    Promoting environmental sustainability
                    and community gardening.
                </p>

                <a href="mailto:contact@greenharvest.org">
                    Contact Organization
                </a>
            </article>

            <article class="organization-card">
                <img
                    src="/images/unityserve-logo.png"
                    alt="UnityServe Volunteers logo"
                >

                <h3>UnityServe Volunteers</h3>

                <p>
                    Connecting volunteers with meaningful
                    community service opportunities.
                </p>

                <a href="mailto:hello@unityserve.org">
                    Contact Organization
                </a>
            </article>

        </div>

    </section>

</main>

<%- include('partials/footer') %>