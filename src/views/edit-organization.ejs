<%- include('partials/header') %>

<main class="container">

    <h1><%= title %></h1>

    <% if (typeof errors !== "undefined" && errors.length > 0) { %>
    <div class="error-message" role="alert">
        <% errors.forEach(error => { %>
            <p><%= error.msg %></p>
        <% }); %>
    </div>
<% } %>

    <form action="/edit-organization/<%= organizationDetails.organization_id %>" method="POST">

        <div class="form-group">
            <label for="name">Organization Name</label>
            <input
                type="text"
                id="name"
                name="name"
                value="<%= organizationDetails.name %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="description">Description</label>
            <textarea
                id="description"
                name="description"
                required><%= organizationDetails.description %></textarea>
        </div>

        <div class="form-group">
            <label for="contactEmail">Contact Email</label>
            <input
                type="email"
                id="contactEmail"
                name="contactEmail"
                value="<%= organizationDetails.contact_email %>"
                required
            >
        </div>

        <div class="form-group">
            <label for="logoFilename">Logo Filename</label>
            <input
                type="text"
                id="logoFilename"
                name="logoFilename"
                value="<%= organizationDetails.logo_filename %>"
                required
            >
        </div>

        <button type="submit">Update Organization</button>

    </form>

    <p>
        <a href="/organizations">Back to Organizations</a>
    </p>

</main>

<%- include('partials/footer') %>