<%- include('partials/header') %>

<main class="container">

    <section class="page-header">
        <h1><%= title %></h1>

        <p>
            Discover volunteer opportunities based on
            your interests and make a difference.
        </p>
    </section>

    <section class="categories">

        <h2>Explore by Interest</h2>

        <div class="category-grid">

            <article class="category-card">
                <h3>Environmental</h3>
                <p>
                    Help protect the environment through
                    conservation, gardening, and cleanup projects.
                </p>
            </article>

            <article class="category-card">
                <h3>Educational</h3>
                <p>
                    Support education through tutoring,
                    mentoring, and learning programs.
                </p>
            </article>

            <article class="category-card">
                <h3>Community Service</h3>
                <p>
                    Improve local communities by helping
                    individuals and families in need.
                </p>
            </article>

            <article class="category-card">
                <h3>Health and Wellness</h3>
                <p>
                    Promote healthy living through
                    wellness programs and community support.
                </p>
            </article>

        </div>

    </section>

</main>

<%- include('partials/footer') %>