<%- include('partials/header') %>

<main class="container">

    <section class="page-header">
        <h1><%= title %></h1>

        <p>
            Discover volunteer opportunities based on
            your interests and make a difference.
        </p>
    </section>

    <section class="categories">

        <h2>Explore by Interest</h2>

        <p>
            <a href="/new-category" class="btn">
                + Create New Category
            </a>
        </p>

        <div class="category-grid">

            <% categories.forEach(category => { %>

                <article class="category-card">

                    <h3>
                        <a href="/category/<%= category.category_id %>">
                            <%= category.name %>
                        </a>
                    </h3>

                    <p>
                        <a href="/edit-category/<%= category.category_id %>">
                            Edit Category
                        </a>
                    </p>

                </article>

            <% }); %>

        </div>

    </section>

</main>

<%- include('partials/footer') %>