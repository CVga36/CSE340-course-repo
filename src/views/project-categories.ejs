<%- include('partials/header') %>

<main class="container">

    <h1><%= title %></h1>
    <h2><%= project.title %></h2>

    <form action="/project/<%= project.project_id %>/categories" method="POST">

        <fieldset>
            <legend>Select Categories</legend>

            <% categories.forEach(category => { %>
                <div class="form-group">
                    <label>
                        <input
                            type="checkbox"
                            name="categoryIds"
                            value="<%= category.category_id %>"
                            <%= selectedCategoryIds.includes(Number(category.category_id)) ? 'checked' : '' %>
                        >
                        <%= category.name %>
                    </label>
                </div>
            <% }); %>

        </fieldset>

        <button type="submit">Save Categories</button>

    </form>

    <p>
        <a href="/project/<%= project.project_id %>">Back to Project</a>
    </p>

</main>

<%- include('partials/footer') %>