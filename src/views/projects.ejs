<%- include('partials/header') %>

<main class="container">

    <section class="page-header">
        <h1><%= title %></h1>

        <p>
            Explore meaningful service opportunities
            and make a positive impact in your community.
        </p>
    </section>

    <section class="projects">

        <h2>Available Service Projects</h2>

        <div class="project-grid">

            <article class="project-card">
                <h3>Community Garden Project</h3>

                <p>
                    Help create and maintain community gardens
                    to promote environmental sustainability.
                </p>

                <p><strong>Category:</strong> Environmental</p>
            </article>

            <article class="project-card">
                <h3>Educational Support Program</h3>

                <p>
                    Volunteer to help students improve their
                    academic skills and achieve their goals.
                </p>

                <p><strong>Category:</strong> Educational</p>
            </article>

            <article class="project-card">
                <h3>Neighborhood Cleanup</h3>

                <p>
                    Join volunteers in cleaning public spaces
                    and improving local neighborhoods.
                </p>

                <p><strong>Category:</strong> Community Service</p>
            </article>

            <article class="project-card">
                <h3>Community Wellness Program</h3>

                <p>
                    Support activities that encourage healthy
                    living and community well-being.
                </p>

                <p><strong>Category:</strong> Health and Wellness</p>
            </article>

        </div>

    </section>

</main>

<%- include('partials/footer') %>